{
  "name": "gpuix",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "bun run build:native && bun run build:react",
    "build:native": "cd packages/native && bun run build",
    "build:react": "cd packages/react && bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "example:counter": "cd examples && bun --hot counter.tsx",
    "dev": "bun scripts/dev.ts",
    "web": "bun scripts/web.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-reconciler": "^0.33.0"
  }
}
