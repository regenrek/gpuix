{
  "name": "@regenrek/gpuix-native",
  "version": "0.5.0-regenrek.8",
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "browser": "browser.mjs",
  "napi": {
    "binaryName": "gpuix-native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/regenrek/gpuix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features test-support",
    "build:release": "napi build --platform --release --no-default-features",
    "build:debug": "napi build --platform --features test-support",
    "build:web": "bun ../../scripts/web.ts --build-only",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @regenrek/gpuix-native locally. CI builds all platform binaries. See AGENTS.md.'); process.exit(1) }\"",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.5.1"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.mjs",
    "wasm",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
