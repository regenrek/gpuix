{
  "name": "@regenrek/gpuix-react",
  "version": "0.5.0-regenrek.14",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "import": "./jsx-runtime.js",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "import": "./jsx-dev-runtime.js",
      "default": "./jsx-dev-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "import": "./dist/components/select.js",
      "default": "./dist/components/select.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js",
      "default": "./dist/components/combobox.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js",
      "default": "./dist/components/tooltip.js"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "import": "./dist/automation/index.js",
      "default": "./dist/automation/index.js"
    }
  },
  "files": [
    "dist",
    "jsx-runtime.js",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.js",
    "jsx-dev-runtime.d.ts",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/regenrek/gpuix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @regenrek/gpuix-react locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run --exclude src/__tests__/render.test.tsx && vitest run src/__tests__/render.test.tsx",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@regenrek/gpuix-native": "0.5.0-regenrek.14",
    "eventsource-parser": "4.1.0",
    "react-reconciler": "0.31.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "25.3.3",
    "@types/react": "19.2.18",
    "@types/react-reconciler": "0.28.9",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
